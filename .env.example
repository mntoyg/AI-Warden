# ============================================================================
#  AI Warden — host-side secret file
#  Copy to .env  (cp .env.example .env)  and fill in only the keys you need.
#
#  SECURITY NOTE
#  This file lives on the HOST and is never copied into the container image.
#  warden-cli.sh injects the values at runtime with `docker run --env-file`,
#  so the keys exist only in the container's process environment and are
#  destroyed when the container exits (`--rm`).
#  Keep this file at mode 600:  chmod 600 .env
# ============================================================================

# ---- Model provider keys --------------------------------------------------
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
PERPLEXITY_API_KEY=
GEMINI_API_KEY=

# ---- Optional: git identity used inside the sandbox -----------------------
GIT_AUTHOR_NAME=
GIT_AUTHOR_EMAIL=

# ---- Optional: GitHub token for `gh` / private clones ---------------------
# Scope this token as narrowly as possible. Prefer a fine-grained PAT
# limited to the single repository the agent is allowed to touch.
GITHUB_TOKEN=

# ---- Warden tuning --------------------------------------------------------
# Hard resource ceilings applied by warden-cli.sh
WARDEN_MEMORY=4g
WARDEN_CPUS=2
WARDEN_PIDS_LIMIT=512
# Set to 0 to disable the out-of-band CAP_KILL sentinel container.
WARDEN_SENTINEL=1
