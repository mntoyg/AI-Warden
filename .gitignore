# ---- AI Warden: host-side secrets (NEVER commit) --------------------------
.env
.env.local
*.pem
*.key

# ---- Sandboxed project roots ---------------------------------------------
# workspaces/ holds real user projects that are bind-mounted into the sandbox.
# Track the directory skeleton only.
workspaces/*
!workspaces/.gitkeep
!workspaces/default/
workspaces/default/*
!workspaces/default/.gitkeep

# ---- warden-model-lab: a SEPARATE repo, kept in this folder on purpose ------
# Our own model's data, checkpoints and GGUF weights (~2.7 GB). It has its own
# .git and its own remote (github.com/mntoyg/warden-model-lab); the training
# CODE lives in notebook/. Anchored so it matches only this exact folder, and
# never to be force-added: an outer commit would record a nested repo, not files.
/warden-model-lab/

# ---- Runtime artefacts ----------------------------------------------------
logs/
*.log
*.pid
run/
.squid-cache/

# ---- OS / editor noise ----------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
*.swp

# Python bytecode
__pycache__/
*.py[cod]
